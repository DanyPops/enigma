{
	"name": "@danypops/enigma-client",
	"version": "0.5.0",
	"license": "MIT",
	"description": "Client for talking to a running Enigma vault: discovers it, presents a token, fetches a credential. Never imports Enigma's own source.",
	"type": "module",
	"keywords": ["enigma", "credentials", "vault-client"],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"files": ["src", "README.md"],
	"scripts": {
		"test": "bun test",
		"check": "bun x tsc --noEmit"
	},
	"dependencies": {
		"@danypops/daemon-kit": "^0.18.0"
	},
	"devDependencies": {
		"bun-types": "latest",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/enigma.git",
		"directory": "packages/enigma-client"
	}
}
