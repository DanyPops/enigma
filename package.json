{
	"name": "enigma-workspace",
	"private": true,
	"type": "module",
	"workspaces": ["packages/*"],
	"scripts": {
		"test": "bun run --filter '*' test",
		"check": "bun run --filter '*' check",
		"format": "biome format --write .",
		"lint": "biome check --write . && eslint packages --max-warnings 0",
		"lint:ci": "biome ci . && eslint packages --max-warnings 0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/enigma.git"
	},
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"eslint": "^10.8.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"jiti": "^2.7.0",
		"typescript-eslint": "^8.65.0"
	}
}
